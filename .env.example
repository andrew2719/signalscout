# Copy this file to .env and fill in your own values. Never commit .env.
#
# MongoDB Atlas connection string: Atlas > your cluster > Connect > Drivers.
# Replace <username> and <password> with a database user from Atlas > Database Access.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-name>.<id>.mongodb.net/?retryWrites=true&w=majority"

# Created by the Atlas onboarding download. Not read by the code (the URI above already
# contains them); kept only so the variable names match the downloaded file.
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
